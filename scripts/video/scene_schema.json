{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene Detection Result v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "scenes"],
  "properties": {
    "version": {"const": "1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "duration", "fps", "width", "height", "codec"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "codec": {"type": "string", "minLength": 1}
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "threshold", "min_scene_len_frames", "pyscenedetect_version"],
      "properties": {
        "method": {"const": "ContentDetector"},
        "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 255},
        "min_scene_len_frames": {"const": 1},
        "pyscenedetect_version": {"type": "string", "minLength": 1}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "start", "end", "duration"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
