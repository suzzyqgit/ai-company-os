// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ActorType {
  HUMAN
  AI
  SYSTEM
}

enum ActorStatus {
  ACTIVE
  INACTIVE
}

enum RevenueTaskStatus {
  TODO
  DOING
  DONE
}

enum RevenueTaskType {
  GENERAL
  CTA_IMPROVEMENT
}

enum ImportApprovalStatus {
  PENDING
  REVIEW_REQUIRED
  APPROVED
  REJECTED
}

model Article {
  id                String   @id @default(cuid())
  title             String
  noteUrl           String   @default("")
  status            String   @default("active")
  price             Int
  pv                Int
  purchases         Int
  baselinePv        Int      @default(0)
  baselinePurchases Int      @default(0)
  note              String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dailyMetrics         ArticleDailyMetric[]
  aiAnalysisRuns       AiAnalysisRun[]
  noteSaleTransactions NoteSaleTransaction[]
  accessImportItems    ArticleAccessImportItem[]
  snapshots            Snapshot[]
  freeArticleDrafts    FreeArticleDraft[]
  freeArticleIdeas     FreeArticleIdea[]
  contentGaps          ContentGap[]
  revenueTasks         RevenueTask[]
}

model ArticleDailyMetric {
  id                String   @id @default(cuid())
  articleId         String
  date              DateTime
  pv                Int      @default(0)
  purchases         Int      @default(0)
  revenue           Int      @default(0)
  masterTransitions Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, date])
  @@index([date])
  @@index([articleId, date])
}

model AiAnalysisRun {
  id           String   @id @default(cuid())
  articleId    String
  type         String
  status       String
  model        String
  inputHash    String
  inputJson    String
  outputJson   String?
  outputText   String?
  errorMessage String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([inputHash])
}

model NoteSaleTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  articleId     String
  occurredAt    DateTime
  date          DateTime
  type          String
  contentType   String
  title         String
  amount        Int
  sourceFile    String
  createdAt     DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, date])
  @@index([date])
}

model ArticleAccessImportRun {
  id              String   @id @default(cuid())
  status          String
  sourceFileCount Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items ArticleAccessImportItem[]
}

model ArticleAccessImportItem {
  id             String   @id @default(cuid())
  runId          String
  articleId      String?
  sourceFileName String
  extractedTitle String
  extractedPv    Int
  previousPv     Int?
  nextPv         Int?
  status         String
  warning        String?
  rawText        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  run     ArticleAccessImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  article Article?               @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([articleId])
  @@index([createdAt])
}

model ImportRun {
  id              String    @id @default(cuid())
  status          String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  importedAt      DateTime
  importedBy      String
  pipelineVersion String
  summaryJson     String?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sources   ImportSource[]
  snapshots Snapshot[]
  canonicalSalesRecords CanonicalSalesRecord[]

  @@index([status])
  @@index([importedAt])
  @@index([importedBy])
}

model ImportSource {
  id             String   @id @default(cuid())
  importRunId    String
  sourceType     String
  sourceFile     String
  sourceHash     String
  parserVersion  String
  confidence     Float?
  metadataJson   String
  createdAt      DateTime @default(now())

  importRun ImportRun  @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  snapshots Snapshot[]
  canonicalSalesRecords CanonicalSalesRecord[]

  @@index([importRunId])
  @@index([sourceHash])
  @@index([sourceType])
}

model CanonicalSalesRecord {
  id             String               @id @default(cuid())
  importRunId    String
  importSourceId String
  businessKey    String
  sourceHash     String
  schemaVersion  String
  parserVersion  String
  saleDate       DateTime
  productName    String
  quantity       Int
  grossAmount    Int
  netAmount      Int?
  currency       String
  platform       String
  source         String
  confidence     Float
  approvalStatus ImportApprovalStatus @default(PENDING)
  validationJson String
  importedAt     DateTime
  importedBy     String
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewReason   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  importRun    ImportRun    @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  importSource ImportSource @relation(fields: [importSourceId], references: [id], onDelete: Cascade)

  @@unique([importSourceId, businessKey, sourceHash])
  @@index([importRunId])
  @@index([importSourceId])
  @@index([approvalStatus])
  @@index([businessKey])
  @@index([sourceHash])
}

model Snapshot {
  id             String    @id @default(cuid())
  importRunId    String
  importSourceId String
  domain         String
  snapshotType   String
  periodStart    DateTime?
  periodEnd      DateTime?
  observedAt     DateTime?
  confidence     Float?
  status         String
  validationStatus String
  dataJson       String
  evidenceJson   String
  articleId      String?
  pv             Int?
  likes          Int?
  comments       Int?
  createdAt      DateTime  @default(now())

  importRun    ImportRun    @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  importSource ImportSource @relation(fields: [importSourceId], references: [id], onDelete: Cascade)
  article      Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([importRunId])
  @@index([importSourceId])
  @@index([domain, snapshotType, status, observedAt])
  @@index([domain, status, createdAt])
  @@index([articleId])
}

model FreeArticleDraft {
  id                   String    @id @default(cuid())
  freeArticleIdeaId    String?   @unique
  title                String
  theme                String
  targetReader         String
  readerProblem        String
  purpose              String
  destinationArticleId String?
  destinationNoteUrl   String
  titleIdeas           String
  outline              String
  body                 String
  introduction         String
  headings             String
  summary              String
  cta                  String
  fullDraft            String
  status               String    @default("READY")
  publishedAt          DateTime?
  publishedUrl         String    @default("")
  publishedPv          Int       @default(0)
  referralCount        Int       @default(0)
  purchaseCount        Int       @default(0)
  improvementCount     Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  destinationArticle Article?         @relation(fields: [destinationArticleId], references: [id], onDelete: SetNull)
  freeArticleIdea    FreeArticleIdea? @relation(fields: [freeArticleIdeaId], references: [id], onDelete: SetNull)

  @@index([destinationArticleId])
  @@index([theme])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model FreeArticleIdea {
  id                   String   @id @default(cuid())
  destinationArticleId String
  theme                String
  title                String
  searchIntent         String
  targetReader         String
  readerProblem        String
  angle                String
  funnelRole           String
  expectedCta          String
  priority             String
  duplicateScore       Int      @default(0)
  titleSimilarityScore Int      @default(0)
  status               String   @default("generated")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  destinationArticle Article           @relation(fields: [destinationArticleId], references: [id], onDelete: Cascade)
  draft              FreeArticleDraft?

  @@index([destinationArticleId])
  @@index([searchIntent])
  @@index([funnelRole])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
}

model ContentGap {
  id             String   @id @default(cuid())
  articleId      String
  category       String
  status         String
  score          Int      @default(0)
  priority       String
  recommendation String
  expectedImpact Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, category])
  @@index([articleId])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([expectedImpact])
}

model TodayTaskCompletion {
  id          String    @id @default(cuid())
  date        DateTime
  taskKey     String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([date, taskKey])
  @@index([date])
  @@index([taskKey])
}

model Actor {
  id          String      @id @default(cuid())
  key         String      @unique
  displayName String
  actorType   ActorType
  status      ActorStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  actorRoles         ActorRole[]
  assignedActorRoles ActorRole[] @relation("ActorRoleAssignedBy")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actorRoles      ActorRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
}

model ActorRole {
  id                String   @id @default(cuid())
  actorId           String
  roleId            String
  assignedAt        DateTime @default(now())
  assignedByActorId String?

  actor           Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  role            Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByActor Actor? @relation("ActorRoleAssignedBy", fields: [assignedByActorId], references: [id], onDelete: SetNull)

  @@unique([actorId, roleId])
  @@index([actorId])
  @@index([roleId])
  @@index([assignedByActorId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model RevenueTask {
  id          String            @id @default(cuid())
  title       String
  type        RevenueTaskType   @default(GENERAL)
  status      RevenueTaskStatus @default(TODO)
  priority    Int
  articleId   String?
  article     Article?          @relation(fields: [articleId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completedAt DateTime?
}
